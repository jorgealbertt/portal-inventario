{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portal de pedidos COISA HOGAR",
  "version": "0.1.0",
  "identifier": "ve.coisahogar.portal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pedidos · COISA HOGAR",
        "width": 1260,
        "height": 860,
        "minWidth": 820,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Inventario y notas de pedido",
    "longDescription": "Portal local para consultar inventario Stellar y preparar pedidos."
  }
}
